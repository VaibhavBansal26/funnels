{
  "name": "funnels-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser smoke tests (Playwright) against the built server serving the built web app.",
  "scripts": {
    "test": "playwright test",
    "install:browsers": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "design:shots": "node design-shots.mjs",
    "design:growth-shots": "node growth-shots.mjs",
    "test:stripe": "playwright test -c playwright.stripe.config.ts",
    "design:shots:ai": "node ai-shots.mjs",
    "design:publish-shots": "node publish-shots.mjs",
    "design:guide-shots": "node guide-shots.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
