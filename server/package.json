{
  "name": "funnels-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx src/seed.ts",
    "docs:config": "tsx scripts/docgen.ts config",
    "docs:api": "tsx scripts/docgen.ts api",
    "docs:check": "vitest run test/docs.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@electric-sql/pglite": "^0.5.10",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "fast-check": "^4.10.2",
    "jsdom": "^29.1.1",
    "mermaid": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
