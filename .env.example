# Copy to .env (never commit it). Everything has a default, so `npm run dev` works with no env at all.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/funnels.db

# Required in production (>= 32 chars). In development a random one is generated at boot.
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=43200
PREVIEW_TOKEN_TTL_SECONDS=900

# Public base URL of the app and the DNS target customers point their domains at.
APP_PUBLIC_URL=http://localhost:3000
APP_PUBLIC_CNAME_TARGET=sites.funnels.example

# Comma-separated lists
CORS_ORIGINS=
PLATFORM_ADMIN_EMAILS=
# Trust X-Forwarded-For (only behind a proxy you control)
TRUST_PROXY=false
# Built web app to serve (default: ../web/dist relative to the server)
WEB_DIST=

# AI: without a key the offline heuristic provider is used
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_DAILY_CAP=50
AI_RATE_LIMIT_PER_MINUTE=10

PUBLIC_EVENTS_PER_MINUTE=120
PUBLIC_FORMS_PER_MINUTE=20
AUTH_ATTEMPTS_PER_MINUTE=10
WEBHOOK_MAX_ATTEMPTS=6
DOMAIN_VERIFY_TIMEOUT_HOURS=72
ENABLE_WORKER=true
JOB_POLL_MS=1000
LOG_LEVEL=info
