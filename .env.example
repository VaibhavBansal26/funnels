# Copy to .env (never commit it). Everything has a default, so `npm run dev` works with no env at all.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Database: unset DATABASE_URL = SQLite file at DATABASE_PATH (zero config). A postgres:// URL switches the whole app to PostgreSQL.
DATABASE_PATH=./data/funnels.db
DATABASE_URL=
# Max connections in the PostgreSQL pool (ignored for SQLite)
DATABASE_POOL_MAX=10
# Read replicas (comma-separated URLs) used by history, lists, exports and analytics; lag guard and read-your-writes stickiness
DATABASE_REPLICA_URLS=
REPLICA_MAX_LAG_MS=2000
REPLICA_STICKY_MS=5000
# false behind PgBouncer in transaction pooling mode (no named prepared statements)
DATABASE_PREPARED_STATEMENTS=true

# Required in production (>= 32 chars). In development a random one is generated at boot.
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=43200
PREVIEW_TOKEN_TTL_SECONDS=900

# Public base URL of the app and the DNS target customers point their domains at.
APP_PUBLIC_URL=http://localhost:3000
APP_PUBLIC_CNAME_TARGET=sites.funnels.example

# Comma-separated lists
CORS_ORIGINS=
PLATFORM_ADMIN_EMAILS=
# Trust X-Forwarded-For (only behind a proxy you control)
TRUST_PROXY=false
# Built web app to serve (default: ../web/dist relative to the server)
WEB_DIST=

# AI: without a key the offline heuristic provider is used
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_DAILY_CAP=50
AI_RATE_LIMIT_PER_MINUTE=10

PUBLIC_EVENTS_PER_MINUTE=120
PUBLIC_FORMS_PER_MINUTE=20
AUTH_ATTEMPTS_PER_MINUTE=10
WEBHOOK_MAX_ATTEMPTS=6
DOMAIN_VERIFY_TIMEOUT_HOURS=72
ENABLE_WORKER=true
JOB_POLL_MS=1000
LOG_LEVEL=info

# --- Cloudflare edge (see docs/CLOUDFLARE.md) ---
# Shared with the worker. Without it /internal/edge/resolve refuses every request.
EDGE_SHARED_SECRET=
EDGE_SKEW_SECONDS=120
# Header secret the worker adds so CF-Connecting-IP can be trusted
CF_ORIGIN_SECRET=
# Cache purge (Cloudflare API) and Cloudflare for SaaS custom hostnames
CF_API_TOKEN=
CF_ZONE_ID=
DOMAIN_PROVIDER=manual
# --- performance / ops ---
EVENT_BUFFER_MS=250
ANALYTICS_DISTINCT_MODE=auto
ANALYTICS_EXACT_DISTINCT_MAX=200000
EVENT_DEDUPE_DAYS=30
PARTITION_MONTHS_AHEAD=3
MAINTENANCE_INTERVAL_HOURS=6
EVENT_BUFFER_MAX=5000
# --- scale: event bus, ingest queue, outbox, ClickHouse mirror (docs/SCALING.md) ---
EVENT_BUS=auto
EVENT_BUS_PARTITIONS=16
INGEST_QUEUE=false
INGEST_MAX_LAG=2000000
OUTBOX_POLL_MS=200
OUTBOX_DOMAIN_EVENTS=false
EVENTSTORE_MIRROR=off
CLICKHOUSE_URL=
CLICKHOUSE_DATABASE=funnels
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
REQUEST_TIMEOUT_MS=30000
# Bearer token required to scrape /metrics (open when empty)
METRICS_TOKEN=

# --- Redis and rate limiting (docs/RATE-LIMITING.md) ---
# Shared limiter state for several replicas. Unset = per-process in-memory limiter.
REDIS_URL=
REDIS_KEY_PREFIX=funnels
REDIS_TIMEOUT_MS=25
RATELIMIT_ENABLED=true
# Fraction of a bucket leased from Redis and spent locally (0 disables)
RATELIMIT_LEASE_FRACTION=0.1
IP_GUARD_PER_MINUTE=1200
PUBLIC_PAGES_PER_MINUTE=6000
API_USER_PER_MINUTE=600
API_WORKSPACE_PER_MINUTE=600
EXPORT_CONCURRENCY=2
EDGE_RESOLVE_PER_MINUTE=120000
# Reverse proxies you own in front of the app (with TRUST_PROXY=true) and Cloudflare address trust
TRUSTED_PROXY_HOPS=1
TRUST_CLOUDFLARE_RANGES=true
CF_IP_RANGES=
CF_API_BASE=https://api.cloudflare.com/client/v4
