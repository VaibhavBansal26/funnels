{
  "$id": "https://funnels.example/analytics-api/v1/funnel-structure.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "live",
              "test"
            ]
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "step_id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "order": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "path": {
                  "type": "string"
                },
                "blocks": {
                  "type": "object",
                  "properties": {
                    "form": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "checkout": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "video": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "countdown": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "form",
                    "checkout",
                    "video",
                    "countdown"
                  ],
                  "additionalProperties": {}
                },
                "word_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "has_order_bump": {
                  "type": "boolean"
                },
                "has_upsell": {
                  "type": "boolean"
                }
              },
              "required": [
                "step_id",
                "name",
                "order",
                "path",
                "blocks",
                "word_count",
                "has_order_bump",
                "has_upsell"
              ],
              "additionalProperties": {}
            }
          },
          "has_order_bump": {
            "type": "boolean"
          },
          "has_upsell": {
            "type": "boolean"
          },
          "word_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "steps",
          "has_order_bump",
          "has_upsell",
          "word_count"
        ],
        "additionalProperties": {}
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "data",
    "next_cursor"
  ],
  "additionalProperties": {}
}
